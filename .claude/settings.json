{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/metaproject_hook.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" post-edit",
            "timeout": 150
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/metaproject_hook.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" pre-bash",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/metaproject-session.sh\"; [ -f \"$f\" ] || exit 0; [ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; bash \"$f\"; exit 0",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
